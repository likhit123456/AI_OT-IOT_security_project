{
  // Type-checks app.js (plain JavaScript with JSDoc types). Nothing is compiled or emitted:
  //   npx -p typescript tsc -p sim_app/static
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "skipLibCheck": true
  },
  "files": ["app.js"]
}
